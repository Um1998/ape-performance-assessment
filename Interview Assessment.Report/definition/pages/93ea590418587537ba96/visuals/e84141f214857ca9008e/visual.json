              "expr": {
                "Literal": {
                  "Value": "'{\n  \"$schema\": \"https://vega.github.io/schema/vega-lite/v5.json\",\n\n  \"data\": {\n    \"name\": \"dataset\"\n  },\n\n  \"height\": {\n    \"step\": 30\n  },\n\n  \"transform\": [\n    {\n      \"calculate\": \"datum.m_APE_Target_Pct >= 1 ? ''Above Target'' : datum.m_APE_Target_Pct >= 0.8 ? ''On Track'' : ''Below Target''\",\n      \"as\": \"Status\"\n    },\n    {\n      \"calculate\": \"0\",\n      \"as\": \"XPos\"\n    }\n  ],\n\n  \"mark\": {\n    \"type\": \"point\",\n    \"filled\": true,\n    \"size\": 300\n  },\n\n  \"encoding\": {\n\n    \"y\": {\n      \"field\": \"agent_name\",\n      \"type\": \"nominal\",\n      \"title\": \"Agent\",\n      \"axis\":{\n        \"labelFontSize\": 16\n      }\n    },\n\n    \"x\": {\n      \"field\": \"XPos\",\n      \"type\": \"quantitative\",\n      \"axis\": null,\n      \"scale\": {\n        \"domain\": [-1, 1]\n      }\n    },\n\n    \"color\": {\n      \"field\": \"Status\",\n      \"type\": \"nominal\",\n      \"legend\": {\n        \"title\": \"Performance\"\n      },\n      \"scale\": {\n        \"domain\": [\n          \"Above Target\",\n          \"On Track\",\n          \"Below Target\"\n        ],\n        \"range\": [\n          \"#00B050\",\n          \"#FFC000\",\n          \"#FF0000\"\n        ]\n      }\n    },\n\n    \"tooltip\": [\n      {\n        \"field\": \"agent_name\",\n        \"title\": \"Agent\"\n      },\n      {\n        \"field\": \"m_ape\",\n        \"title\": \"APE\",\n        \"format\": \",.0f\"\n      },\n      {\n        \"field\": \"m_target\",\n        \"title\": \"Target\",\n        \"format\": \",.0f\"\n      },\n      {\n        \"field\": \"m_APE_Target_Pct\",\n        \"title\": \"Achievement %\",\n        \"format\": \".1%\"\n      }\n    ]\n  },\n\n  \"config\": {\n    \"view\": {\n      \"stroke\": null\n    }\n  }\n}'"
