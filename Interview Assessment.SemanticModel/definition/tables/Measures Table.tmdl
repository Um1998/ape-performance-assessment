table 'Measures Table'
	lineageTag: a7931ee6-a82a-4bd4-b757-94d138355648

	measure m_agents_count =
			
			var AgentSales = DISTINCTCOUNT(fact_sales[agent_id])
			var AgentAgent = DISTINCTCOUNT(dim_agent[agent_id])
			RETURN AgentAgent
		formatString: 0
		isHidden
		lineageTag: 5d2bf824-adb3-4149-a10a-ad9847f7ee80

		changedProperty = IsHidden

	measure m_ape = ```
			
			// SUM(fact_sales[ape_usd])
			SUMX (
			    fact_sales,
			    IF (
			        RELATED ( dim_product[premium_type] ) = "single",
			        fact_sales[ape_usd] / 10,
			        fact_sales[ape_usd]
			    )
			)
			
			```
		formatString: 0.0
		lineageTag: 4fb15985-dbe9-4d02-98f2-8ed688448ae6

	measure m_ape(YTD) =
			
			TOTALYTD(
			    [m_ape],
			    dim_date[date]
			)
		lineageTag: 41b6daa4-d3b4-4abb-ad88-bf7f1f71111d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure m_ape_rolling_3_months =
			
			CALCULATE(
			    [m_ape],
			    DATESINPERIOD(
			        dim_date[date],
			        MAX(dim_date[date]),
			        -3,
			        MONTH
			    )
			)
		lineageTag: 62867c49-9248-44fb-9f30-02a7c81e8980

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure m_policies_renewed = ```
			
			CALCULATE(
			    COUNTROWS(fact_persistency), 
			    fact_persistency[renewal_status] = "renewed" 
			)
			```
		formatString: 0
		lineageTag: a5be1ad1-333f-473c-bd8a-7ca194245099

	measure m_policies_due =
			
			CALCULATE(
			    COUNTROWS(FILTER( fact_persistency,
			            fact_persistency[renewal_status] IN { "renewed", "lapsed", "grace" } ))
			)
		formatString: 0
		lineageTag: 54dc2d3e-b054-4377-b0fa-f7dbd09e137c

	measure m_persistency_rate = ```
			
			    DIVIDE(
			        COUNTROWS( FILTER( fact_persistency, fact_persistency[renewal_status] = "renewed" ) ),
			        COUNTROWS( FILTER( fact_persistency,
			            fact_persistency[renewal_status] IN { "renewed", "lapsed", "grace" } ) )
			    )
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 85af5c05-ab27-4a8a-b92c-ab9ee2311c7b

	measure m_active_agent_count =
			
			CALCULATE(
			    DISTINCTCOUNT(dim_agent[agent_id]),
			    dim_agent[active_flag] = 1
			)
		formatString: 0
		lineageTag: 22c9a0e7-6c68-4c68-94d9-3b13dd8b76cc

	measure m_agent_rank_ytd =
			
			RANKX(
			    ALL(dim_agent[agent_name],dim_agent[agent_indentifier]),
			    [m_ape_ytd_latest],
			    ,
			    DESC,
			    DENSE
			)
		formatString: 0
		lineageTag: 5748e0f4-e849-4b8c-af04-f0b3d9e00c4f

	measure m_target =
			
			SUM(fact_target[ape_target_usd])
		lineageTag: 7d780860-964a-4b8f-9293-dcc290e1de8c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure m_performance_status =
			
			SWITCH(
			    TRUE(),
			    [m_APE_Target_Pct] >= 1, "Above Target",
			    [m_APE_Target_Pct] >= 0.8, "On Track",
			    "Below Target"
			)
		lineageTag: 686c57d8-327c-4f1a-86f6-8f896685d9a2

	measure m_selected_agent =
			
			SELECTEDVALUE(
			    dim_agent[agent_name],
			    "Select an Agent"
			)
		lineageTag: 723cdfb7-64fc-4106-8486-00ab0ede57c8

	measure m_territory =
			
			SELECTEDVALUE(
			    dim_agent[territory]
			)
		lineageTag: e77c49d4-019e-4264-959a-f6b02fc25406

	measure m_top_product =
			
			VAR T =
			TOPN(
			    1,
			    VALUES(dim_product[product_name]),
			    [m_ape],
			    DESC
			)
			RETURN
			MAXX(
			    T,
			    dim_product[product_name]
			)
		lineageTag: d1ec9881-17fc-4200-a542-d02c22ad6c43

	measure m_mom_change =
			
			DIVIDE(
			    [m_latest_month_ape] - [m_prior_month_ape],
			    [m_prior_month_ape]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 7cb9125d-ac87-4f50-bca4-25b7fb486447

	measure m_trend_arrow =
			
			IF(
			    [m_mom_change] >= 0,
			    "▲",
			    "▼"
			)
		lineageTag: 389be560-c859-4d81-b854-6693ef442b54

	measure m_agent_profile_html =
			
			"
			<div style='font-family:Segoe UI;
			padding:20px;
			border:2px solid #0078D4;
			border-radius:12px;
			background-color:#F8F9FA'>
			
			<h2 style='color:#0078D4'>
			Agent Profile
			</h2>
			
			<p><b>Agent:</b> " &
			[m_selected_agent] &
			"</p>
			
			<p><b>Territory:</b> " &
			[m_territory] &
			"</p>
			
			<p><b>YTD APE:</b> " &
			FORMAT([m_ape_ytd_latest],"#,##0") &
			"</p>
			
			<p><b>Rank:</b> " &
			FORMAT([m_agent_rank_ytd],"0") &
			"</p>
			
			<p><b>MoM Trend:</b> " &
			[m_trend_arrow] & " " &
			FORMAT([m_mom_change],"0.0%") &
			"</p>
			
			<p><b>Top Product:</b> " &
			[m_top_product] &
			"</p>
			
			<p><b>Persistency:</b> " &
			FORMAT([m_persistency_rate],"0.0%") &
			"</p>
			
			</div>
			"
		lineageTag: dbe8cd55-b230-410c-b945-267cebdee96b

	measure m_total_ape =
			
			SUMX(
			    fact_sales,
			    var Premium = fact_sales[ape_usd]
			    var Policies = fact_sales[policies_issued]
			    var IsSingle = RELATED(dim_product[premium_type]) = "Single"
			    RETURN Premium * Policies / IF(IsSingle,10,1)
			)
		isHidden
		lineageTag: 17788bc5-db1c-4930-bb35-9181f838aadc

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure m_APE_Target_Pct =
			
			DIVIDE(
			    [m_ape],
			    [m_target]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 6764912b-6a39-4bd2-9a0b-f068b07f4fff

	measure 'APE (YTD) Last Year' =
			
			CALCULATE(
			    [m_ape(YTD)],
			    SAMEPERIODLASTYEAR(dim_date[date])
			)
		isHidden
		lineageTag: 68ba87c0-7bc0-48d8-8abe-a6f6206330b2

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure m_latest_month_ape =
			
			VAR LatestDateKey = CALCULATE( MAX( fact_sales[date_key] ) )
			VAR LatestDate = LOOKUPVALUE( dim_date[date], dim_date[date_key], LatestDateKey )
			VAR MonthStart = DATE( YEAR(LatestDate), MONTH(LatestDate), 1 )
			VAR MonthEnd = EOMONTH( MonthStart, 0 )
			RETURN
			CALCULATE(
			    [m_ape],
			    REMOVEFILTERS( dim_date ),
			    dim_date[date] >= MonthStart,
			    dim_date[date] <= MonthEnd
			)
		lineageTag: 7241a8f8-7c6a-4dd2-84ac-ad51345c11b4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure m_prior_month_ape =
			
			VAR LatestDateKey = CALCULATE( MAX( fact_sales[date_key] ) )
			VAR LatestDate = LOOKUPVALUE( dim_date[date], dim_date[date_key], LatestDateKey )
			VAR CurrentMonthStart = DATE( YEAR(LatestDate), MONTH(LatestDate), 1 )
			VAR PriorMonthEnd = CurrentMonthStart - 1
			VAR PriorMonthStart = DATE( YEAR(PriorMonthEnd), MONTH(PriorMonthEnd), 1 )
			RETURN
			CALCULATE(
			    [m_ape],
			    REMOVEFILTERS( dim_date ),
			    dim_date[date] >= PriorMonthStart,
			    dim_date[date] <= PriorMonthEnd
			)
		lineageTag: f11d57d6-73dc-49f2-a6f0-0f148de76ea9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure m_ape_ytd_latest =
			
			VAR LatestDateKey = CALCULATE( MAX( fact_sales[date_key] ), REMOVEFILTERS( dim_date ) )
			VAR LatestDate = LOOKUPVALUE( dim_date[date], dim_date[date_key], LatestDateKey )
			VAR YearStart = DATE( YEAR(LatestDate), 1, 1 )
			RETURN
			CALCULATE(
			    [m_ape],
			    REMOVEFILTERS( dim_date ),
			    dim_date[date] >= YearStart,
			    dim_date[date] <= LatestDate
			)
		lineageTag: 10c32abe-fd19-4280-b2f0-a2f517dac99f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure m_policy_issued = COUNTROWS(fact_persistency)
		formatString: 0
		lineageTag: afe53133-2868-454f-a130-9bed77e89c91

	measure m_cohort_persistency = ```
			
			CALCULATE (
			    [m_persistency_rate],
			    ALLEXCEPT ( fact_persistency, fact_persistency[issue_date_key], fact_persistency[renewal_due_date_key] )
			)
			
			```
		lineageTag: 9f1d9c10-e54d-49a2-94eb-709dd418bd36

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure m_active_policy_count =
			
			VAR SnapshotDateKey =
			    CALCULATE( MAX( dim_date[date_key] ), REMOVEFILTERS( dim_date ) )
			RETURN
			CALCULATE(
			    COUNTROWS(
			        FILTER(
			            fact_persistency,
			            fact_persistency[issue_date_key] <= SnapshotDateKey
			                && (
			                    fact_persistency[renewal_due_date_key] > SnapshotDateKey
			                    || fact_persistency[renewal_status] <> "lapsed"
			                )
			        )
			    ),
			    REMOVEFILTERS( dim_date )
			)
		formatString: 0
		lineageTag: d8ba5cc7-995c-46e5-9fc0-4eee6f07f91a

	measure m_persistency_rate_cohort =
			
			CALCULATE(
			    DIVIDE(
			        COUNTROWS( FILTER( fact_persistency, fact_persistency[renewal_status] = "renewed" ) ),
			        COUNTROWS( FILTER( fact_persistency, fact_persistency[renewal_status] IN { "renewed", "lapsed", "grace" } ) )
			    ),
			    USERELATIONSHIP( fact_persistency[issue_date_key], dim_date[date_key])
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 445da072-f00a-4669-bf1a-7122f022898e

	measure m_policy_count_cohort =
			
			CALCULATE(
			    COUNTROWS(
			        FILTER(
			            fact_persistency,
			            fact_persistency[renewal_status] IN { "renewed", "lapsed", "grace" }
			        )
			    ),
			    USERELATIONSHIP( fact_persistency[issue_date_key], dim_date[date_key])
			)
		formatString: 0
		lineageTag: 231959a1-df8d-4546-949c-2c533e3a6a0b

	column Column1
		dataType: string
		isHidden
		lineageTag: 9a65bdbd-fd1e-40f7-93ca-0125ba9a48e5
		summarizeBy: none
		sourceColumn: Column1

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition 'Measures Table' = m
		mode: import
		source =
				let
				  Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t])
				in
				  Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

